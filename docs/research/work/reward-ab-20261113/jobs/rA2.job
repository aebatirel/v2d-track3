# reward A/B box rA2: ep40 ep23 (training order). Plan + PREREG: docs/research/work/reward-ab-20261113/README.md
R0=20261020-refsweep-ea14fdf
for i in 1 2 3; do PULL_SUB="perc2/ep40" bash ops/box/store.sh pull-run $R0 >> /content/prepull.log 2>&1 && PULL_SUB="refs/perc2s/ep40" bash ops/box/store.sh pull-run 20261113-gA2-25cb421 >> /content/prepull.log 2>&1 && break; echo "[$(date -u +%FT%TZ)] reward A/B: pull for ep40 failed (try $i)" >> /content/job.log; sleep 120; done
bash ops/box/store.sh pull-files runs/20261113-gA2-25cb421/results/perc2s/ep40-s42/selection.json >> /content/prepull.log 2>&1
CK=$(python3 -c "import json; print(json.load(open('/content/hfstore/runs/20261113-gA2-25cb421/results/perc2s/ep40-s42/selection.json'))['chosen'])")
bash ops/box/store.sh pull-files runs/20261113-gA2-25cb421/runs/perc2s/ep40-s42/$(basename $CK) >> /content/prepull.log 2>&1
mkdir -p /content/results/perc2s/ep40-s42 /content/runs/perc2s/ep40-s42 && cp /content/hfstore/runs/20261113-gA2-25cb421/results/perc2s/ep40-s42/selection.json /content/results/perc2s/ep40-s42/ && cp /content/hfstore/runs/20261113-gA2-25cb421/runs/perc2s/ep40-s42/$(basename $CK) $CK
for i in 1 2 3; do PULL_SUB="perc2/ep23" bash ops/box/store.sh pull-run $R0 >> /content/prepull.log 2>&1 && PULL_SUB="refs/perc2s/ep23" bash ops/box/store.sh pull-run 20261113-gA3-25cb421 >> /content/prepull.log 2>&1 && break; echo "[$(date -u +%FT%TZ)] reward A/B: pull for ep23 failed (try $i)" >> /content/job.log; sleep 120; done
bash ops/box/store.sh pull-files runs/20261113-gA3-25cb421/results/perc2s/ep23-s42/selection.json >> /content/prepull.log 2>&1
CK=$(python3 -c "import json; print(json.load(open('/content/hfstore/runs/20261113-gA3-25cb421/results/perc2s/ep23-s42/selection.json'))['chosen'])")
bash ops/box/store.sh pull-files runs/20261113-gA3-25cb421/runs/perc2s/ep23-s42/$(basename $CK) >> /content/prepull.log 2>&1
mkdir -p /content/results/perc2s/ep23-s42 /content/runs/perc2s/ep23-s42 && cp /content/hfstore/runs/20261113-gA3-25cb421/results/perc2s/ep23-s42/selection.json /content/results/perc2s/ep23-s42/ && cp /content/hfstore/runs/20261113-gA3-25cb421/runs/perc2s/ep23-s42/$(basename $CK) $CK
for x in 40:26b969a60c506fefe076b1a3ce1a3b628f2da0297b5b0c0b6e372c974752c121 23:4ad4020ceabd333a21988693a9bc90074c7714ce25bcc9913174c1f86e4f98d2 ; do
  e=${x%%:*}; f=$(ls /content/refs/perc2s/ep$e/processed/*/*/*.parquet 2> /dev/null | head -1)
  [ -n "$f" ] && [ "$(sha256sum < $f | cut -c1-64)" = "${x#*:}" ] && [ -s /content/perc2/ep$e/poses.npz ] && [ -s "$(python3 -c "import json; print(json.load(open(\"/content/results/perc2s/ep$e-s42/selection.json\"))[\"chosen\"])")" ] \
    || { echo "[$(date -u +%FT%TZ)] reward A/B: ep$e reference, perception or control checkpoint missing, or reference sha256 mismatch" >> /content/job.log; exit 1; }
  echo "[$(date -u +%FT%TZ)] reward A/B: ep$e reference $f sha256 OK (test A input); control checkpoint present" >> /content/job.log
done
. /content/v2d-track3/ops/box/lib.sh
export FC_FDR_OBJ=1 FC_FDR_TIPS=1 FC_VOC_INERTIA=1 FC_IMMEDIATE_FIRST_FRAME=0.25 TRAIN_ARGS="$FDR_TRAIN_ARGS" \
