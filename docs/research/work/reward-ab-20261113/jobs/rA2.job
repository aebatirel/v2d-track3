  SPLIT=public PDIR_ROOT=/content/perc2 SUF=c CR=0 BASE_EVAL=1 NREP=5 SEED=42 LIB=/content/v2d-track3/meshes/library_v3 \
  PAIRS="40:local:s 23:local:s"
bash ops/jobs/hard_ab.sh
