# Non-secret settings for ops/vast.sh (sourced). Secrets never go in this file or anywhere in git.
# HF_STORE: the private Hugging Face dataset repo used as the artifact store (owner creates it; fill in the HF user).
HF_STORE=${HF_STORE:-aebatirel/v2d-store}
# Same torch / CUDA / Python as the validated Colab runtime (torch 2.11+cu130, Python 3.13). Env snapshots are only
# valid for the image they were built on.
IMAGE=${IMAGE:-vastai/pytorch:2.11.0-cu130-cuda-13.2-mini-py313-2026-10-16}
DISK=${DISK:-150}
